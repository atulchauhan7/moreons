<span class="payment-icon" title="Google Pay"><svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Google Pay"><rect width="38" height="24" rx="3" fill="#fff" stroke="#e8e8e8"/><path d="M18.3 12.2v2.6h-.8V8.4h2.2c.5 0 1 .2 1.4.5.4.4.6.8.6 1.3s-.2 1-.6 1.3c-.4.4-.9.5-1.4.5h-1.4v.2zm0-3v2.3h1.5c.3 0 .6-.1.8-.4.5-.4.5-1.1.1-1.5-.2-.2-.5-.4-.8-.4h-1.6z" fill="#5F6368"/><path d="M23.7 10.1c.6 0 1.1.2 1.5.5.4.3.6.8.6 1.4v2.8H25v-.6c-.3.5-.8.7-1.4.7-.5 0-1-.2-1.3-.5-.3-.3-.5-.6-.5-1 0-.4.2-.8.5-1 .3-.3.8-.4 1.4-.4.5 0 .9.1 1.2.4v-.3c0-.3-.1-.6-.4-.8-.2-.2-.5-.3-.8-.3-.5 0-.9.2-1.1.6l-.7-.4c.3-.6.9-1 1.8-1zm-1 3.3c0 .2.1.4.3.6.2.2.5.2.7.2.4 0 .7-.2 1-.4.3-.3.4-.6.4-.9-.3-.2-.7-.4-1.2-.4-.4 0-.7.1-.9.3-.2.2-.3.4-.3.6z" fill="#5F6368"/><path d="M29.2 10.2l-2.7 6.2h-.8l1-2.2-1.8-4h.9l1.3 3.1 1.3-3.1h.8z" fill="#5F6368"/><path d="M15.7 11.4c0-.3 0-.5-.1-.8h-3.4v1.4h2c-.1.5-.3.9-.7 1.1v1h1.1c.7-.6 1.1-1.5 1.1-2.7z" fill="#4285F4"/><path d="M12.2 14.1c.9 0 1.7-.3 2.3-.9l-1.1-1c-.3.2-.7.4-1.2.4-.9 0-1.7-.6-2-1.5H9v.9c.6 1.2 1.8 2.1 3.2 2.1z" fill="#34A853"/><path d="M10.2 11.2c-.1-.3-.2-.6-.2-1s.1-.7.2-1V8.4H9c-.3.6-.5 1.2-.5 1.9s.2 1.3.5 1.9l1.2-1z" fill="#FBBC04"/><path d="M12.2 8.7c.5 0 1 .2 1.3.5l1-.9C13.9 7.7 13.1 7.4 12.2 7.4 10.8 7.4 9.6 8.3 9 9.4l1.2 1c.3-.9 1.1-1.7 2-1.7z" fill="#EA4335"/></svg></span>
<span class="payment-icon" title="Shop Pay"><svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Shop Pay"><rect width="38" height="24" rx="3" fill="#5A31F4"/><path d="M21.4 9.3c-.5 0-1 .1-1.2.2v4.1c.3.1.5.1.9.1 1.3 0 2-.7 2-2.3 0-1.4-.7-2.1-1.7-2.1zM9.2 10.4c-.4 0-.7.1-1 .2v2c.3.1.5.1.8.1.8 0 1.3-.4 1.3-1.2 0-.7-.4-1.1-1.1-1.1z" fill="#fff"/><path d="M24.8 7H13.2c-.4 1.4-1.5 2.6-2.9 3.2h0c.3-.1.7-.1 1-.1 1.4 0 2.2.8 2.2 2 0 1.3-.9 2.2-2.5 2.2-.4 0-.8 0-1.2-.1-.2.6-.4 1.2-.4 1.8H24.8c1.4 0 2.5-1.1 2.5-2.5V9.5c0-1.4-1.1-2.5-2.5-2.5zm-3.1 7c-.4.1-1 .1-1.3.1-2 0-3-1.1-3-3 0-2 1.2-3.1 3.1-3.1.4 0 .9.1 1.2.2l-.2 1c-.3-.1-.6-.2-1-.2-1.1 0-1.8.7-1.8 2.1 0 1.3.6 2 1.7 2h.2l.4 1h-.3 0zM14.6 14.7l.4-1c-.4-.2-.6-.5-.6-1v-2.3c0-.4.1-.8.2-1.2H13l-.2.8c-.3-.5-.8-.9-1.7-.9-.7 0-1.2.2-1.6.5.2-.6.3-1.3.3-2h8.8l-.5-.7H6.9c-.7 2.2-2.7 3.9-5 4.2v.7h2.3c-.3.6-.5 1.3-.5 2 0 1.5 1 2.5 2.3 2.5h9.1l.2-.9c-.2-.3-.5-.5-.7-.7z" fill="#fff"/></svg></span>
</div>
</div>
</div>
</div>
</div>
</form>
{% else %}
<div class="page-404" data-animate="fade-up">
