<!-- Organization + WebSite structured data (helps branded search ranking) -->
<script type="application/ld+json">
{
"@context": "https://schema.org",
"@type": "Organization",
"name": {{ shop.name | json }},
"url": {{ request.origin | json }},
{% if settings.favicon != blank %}"logo": {{ settings.favicon | image_url: width: 512 | prepend: 'https:' | json }},{% endif %}
"sameAs": [{% assign first_social = true %}{% if settings.social_facebook != blank %}{% unless first_social %},{% endunless %}{{ settings.social_facebook | json }}{% assign first_social = false %}{% endif %}{% if settings.social_instagram != blank %}{% unless first_social %},{% endunless %}{{ settings.social_instagram | json }}{% assign first_social = false %}{% endif %}{% if settings.social_twitter != blank %}{% unless first_social %},{% endunless %}{{ settings.social_twitter | json }}{% assign first_social = false %}{% endif %}]
}
</script>
<script type="application/ld+json">
{
"@context": "https://schema.org",
"@type": "WebSite",
"name": {{ shop.name | json }},
"url": {{ request.origin | json }},
"potentialAction": {
  "@type": "SearchAction",
  "target": {
    "@type": "EntryPoint",
    "urlTemplate": "{{ request.origin }}{{ routes.search_url }}?q={search_term_string}"
  },
