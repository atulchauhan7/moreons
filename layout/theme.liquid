{% if template.name == 'collection' or template.name == 'product' %}
<script type="application/ld+json">
{
"@context": "https://schema.org",
"@type": "BreadcrumbList",
"itemListElement": [
  {"@type": "ListItem", "position": 1, "name": "Home", "item": "{{ request.origin }}"}
  {% if template.name == 'collection' %},{"@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }}}
  {% elsif template.name == 'product' %}{% if product.collections.size > 0 %},{"@type": "ListItem", "position": 2, "name": {{ product.collections.first.title | json }}, "item": {{ request.origin | append: product.collections.first.url | json }}}{% endif %},{"@type": "ListItem", "position": {% if product.collections.size > 0 %}3{% else %}2{% endif %}, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }}}
  {% endif %}
]
}
</script>
{% endif %}

<script>
document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
window.theme = {
moneyFormat: {{ shop.money_format | json }},
currency: {{ cart.currency.iso_code | json }},
cartCount: {{ cart.item_count }},
goEnabled: {{ settings.goEnable | json }},
cartRecsHandle: {{ settings.cart_recs_collection | default: 'accessories' | json }},
routes: {
cart_url: '{{ routes.cart_url }}',
cart_add_url: '{{ routes.cart_add_url }}',
cart_change_url: '{{ routes.cart_change_url }}',
search_url: '{{ routes.search_url }}',
checkout_url: '{{ routes.checkout_url }}'
}
};
/* Hide page loader as soon as DOM is parsed — don't wait for images/fonts.
   Without this, the brand-color overlay sits over the page until window.load. */
(function(){
  var hidden = false;
  function hideLoader(){
    if(hidden) return; hidden = true;
    var lo = document.getElementById('page-loader');
    if(lo) lo.classList.add('loaded');
    document.body.classList.remove('overflow-hidden');
    if(!document.body.classList.contains('page-loaded')) document.body.classList.add('page-loaded');
  }
  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', hideLoader, {once:true});
  } else {
    hideLoader();
  }
  /* Hard cap so the loader can never stick if DOMContentLoaded is missed */
  setTimeout(hideLoader, 500);
})();
</script>
{% if settings.enable_shopflo %}
<script>
(function(){
  var h=window.location.hostname;
  var isLocal=(h==='localhost'||h==='127.0.0.1');
  var realHost={{ shop.permanent_domain | json }};
  window.Shopflo=Object.assign({},window.Shopflo||{},{autoOnboarding:true});
  if(isLocal&&realHost){
    var _fetch=window.fetch;
    window.fetch=function(url,opts){
      if(typeof url==='string'&&(url.indexOf('shopUrl=localhost')!==-1||url.indexOf('shop-url=localhost')!==-1||url.indexOf('shop_url=localhost')!==-1)){
        url=url.replace(/shop[_-]?[Uu]rl=localhost[^&]*/g,function(m){return m.replace(/=localhost[^&]*/,'='+realHost)});
      }
      return _fetch.apply(this,arguments);
    };
  }
  var s=document.createElement('script');
  s.src='https://bridge.shopflo.com/js/shopflo.bundle.js';
  s.async=true;
  document.head.appendChild(s);
})();
</script>
{% endif %}

