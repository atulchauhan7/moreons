<div class="wishlist-drawer-overlay" aria-hidden="true"></div>
<div class="wishlist-drawer" role="dialog" aria-modal="true" aria-label="Wishlist">
<div class="wishlist-drawer__header">
<div class="wishlist-drawer__header-info">
<span class="wishlist-drawer__title">My Wishlist</span>
<span class="wishlist-drawer__subtitle"><span class="wishlist-count">0</span> <span data-wishlist-noun>items</span> saved</span>
</div>
<span class="wishlist-drawer__count-badge" aria-label="wishlist items"><span class="wishlist-count">0</span></span>
<button class="wishlist-drawer__close" aria-label="Close wishlist">
<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<line x1="18" y1="6" x2="6" y2="18"/>
<line x1="6" y1="6" x2="18" y2="18"/>
</svg>
</button>
</div>

<div class="wishlist-drawer__items">
<!-- Items rendered by JS -->
</div>

<div class="wishlist-drawer__empty">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
</svg>
<p>Your wishlist is empty</p>
<a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Explore Products</a>
</div>

<div class="wishlist-drawer__footer sk-hidden">
<a href="{{ routes.all_products_collection_url }}" class="btn btn--secondary btn--full">Continue Shopping</a>
</div>
</div>
