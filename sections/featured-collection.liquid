{% assign collection = collections[section.settings.collection] %}
<section class="section" data-section-id="{{ section.id }}">
<div class="container">
<div class="bwk-section__head" data-animate="fade-up">
<h2 class="bwk-section__title split-words">{{ section.settings.title }}{% if section.settings.title_suffix != blank %} <span class="bwk-section__title-suffix">{{ section.settings.title_suffix }}</span>{% endif %}</h2>
{% if section.settings.show_view_all %}
<a href="{{ collection.url | default: routes.all_products_collection_url }}" class="bwk-section__link">
View All
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
</a>
{% endif %}
</div>

<div class="carousel featured-carousel"
data-carousel
data-carousel-per-view="{{ section.settings.columns }}"
data-carousel-gap="24"
data-carousel-autoplay="{{ section.settings.autoplay }}"
data-carousel-speed="4000"
data-carousel-loop="true"
data-animate="fade-up" data-animate-delay="200">
<div class="carousel__viewport">
<div class="carousel__track" data-carousel-track>
{% for product in collection.products limit: section.settings.products_to_show %}
<div class="carousel__slide" data-carousel-slide style="padding: 0 12px;">
{% render 'product-card', product: product %}
</div>
{% else %}
{% for i in (1..section.settings.products_to_show) %}
<div class="carousel__slide" data-carousel-slide style="padding: 0 12px;">
{% render 'product-card-placeholder' %}
</div>
{% endfor %}
{% endfor %}
</div>
</div>
<div class="carousel__dots" data-carousel-dots></div>
</div>

</div>
</section>

{% schema %}
{"name":"Featured Collection","settings":[{"type":"text","id":"subtitle","label":"Subtitle","default":"Curated for you"},{"type":"text","id":"title","label":"Title","default":"Featured Products"},{"type":"text","id":"title_suffix","label":"Title suffix (lighter weight)","info":"Appended after the title in a lighter style, e.g. 'Of The Season'"},{"type":"textarea","id":"description","label":"Description","default":"Handpicked essentials that embody quality and timeless design"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":12,"step":1,"default":8},{"type":"select","id":"columns","label":"Products per view","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"4"},{"type":"checkbox","id":"autoplay","label":"Auto-rotate slides","default":true},{"type":"checkbox","id":"show_view_all","label":"Show \u0027View All\u0027 button","default":true}],"presets":[{"name":"Featured Collection"}]}
{% endschema %}