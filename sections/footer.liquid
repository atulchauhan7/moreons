<footer class="site-footer" id="site-footer-landmark" data-section-id="{{ section.id }}" role="contentinfo" aria-label="Site footer">

{% comment %} === TRUST STRIP — 4-item benefits grid === {% endcomment %}
{% assign benefit_blocks = section.blocks | where: "type", "benefit" %}
{% if benefit_blocks.size > 0 %}
<section class="trust-strip" aria-label="Why shop with us">
  <div class="container">
    <div class="trust-strip__grid">
      {% for block in benefit_blocks %}
      <div class="trust-strip__card" {{ block.shopify_attributes }}>
        <div class="trust-strip__icon-wrap" aria-hidden="true">
          {% render 'footer-benefit-icon', icon: block.settings.icon %}
        </div>
        <div class="trust-strip__body">
          {% if block.settings.title != blank %}
          <strong class="trust-strip__title">{{ block.settings.title }}</strong>
          {% endif %}
          {% if block.settings.text != blank %}
          <span class="trust-strip__sub">{{ block.settings.text }}</span>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<div class="site-footer__newsletter-bar">
<div class="container">
<div class="site-footer__newsletter-inner" data-animate="fade-up">
<div class="site-footer__newsletter-text">
<h4 class="site-footer__newsletter-title">Join Our Community</h4>
<p>Subscribe for exclusive access to new arrivals, offers & style inspiration.</p>
</div>
<div class="site-footer__newsletter-form-wrap">
{% form 'customer', class: 'site-footer__newsletter-form' %}
<input type="hidden" name="contact[tags]" value="newsletter,footer">
<input type="email" name="contact[email]" class="site-footer__newsletter-input" placeholder="Enter your email address" required autocomplete="email" aria-label="Email address">
<button type="submit" class="site-footer__newsletter-btn">
Subscribe
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
</button>
{% endform %}
</div>
</div>
</div>
</div>

<div class="container">
<div class="site-footer__grid" data-animate="fade-up">
<div class="site-footer__brand-col">
<a href="{{ routes.root_url }}" class="site-footer__brand">{{ shop.name }}</a>
<p class="site-footer__about">{{ section.settings.about_text }}</p>
{% if section.settings.address_text != blank %}
<p class="site-footer__address">{{ section.settings.address_text }}</p>
{% endif %}
{% if section.settings.whatsapp_number != blank %}
<a href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}" class="site-footer__whatsapp" target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp">
<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
Chat with us
</a>
{% endif %}
{% if section.settings.support_email != blank %}
<a href="mailto:{{ section.settings.support_email }}" class="site-footer__email" aria-label="Email us">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 4l-10 8L2 4"/></svg>
{{ section.settings.support_email }}
</a>
{% endif %}
</div>

{% assign quick_link_blocks = section.blocks | where: "type", "quick_link" %}
{% if quick_link_blocks.size > 0 %}
<div class="site-footer__menu-col" data-always-open>
<div class="site-footer__heading-wrap">
<h4 class="site-footer__heading">{{ section.settings.quick_links_heading | default: 'Quick Links' }}</h4>
</div>
<div class="site-footer__links">
{% for block in quick_link_blocks %}
{% if block.settings.link_label != blank %}
<a href="{{ block.settings.link_url | default: '#' }}" class="site-footer__link" {{ block.shopify_attributes }}>{{ block.settings.link_label }}</a>
{% endif %}
{% endfor %}
</div>
</div>
{% endif %}
</div>

<div class="site-footer__bottom" data-animate="fade-up" data-animate-delay="200">
<p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All Rights Reserved</p>
<div class="site-footer__social">
{% if settings.social_facebook != blank %}
<a href="{{ settings.social_facebook }}" class="site-footer__social-link" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
</a>
{% endif %}
{% if settings.social_instagram != blank %}
<a href="{{ settings.social_instagram }}" class="site-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
</a>
{% endif %}
{% if settings.social_twitter != blank %}
<a href="{{ settings.social_twitter }}" class="site-footer__social-link" aria-label="Twitter" target="_blank" rel="noopener noreferrer">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
</a>
{% endif %}
{% if settings.social_linkedin != blank %}
<a href="{{ settings.social_linkedin }}" class="site-footer__social-link" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
</a>
{% endif %}
{% if settings.social_pinterest != blank %}
<a href="{{ settings.social_pinterest }}" class="site-footer__social-link" aria-label="Pinterest" target="_blank" rel="noopener noreferrer">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 12a4 4 0 1 1 8 0c0 3-2 5-4 7"/><line x1="12" y1="12" x2="10" y2="22"/></svg>
</a>
{% endif %}
{% if settings.social_tiktok != blank %}
<a href="{{ settings.social_tiktok }}" class="site-footer__social-link" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
</a>
{% endif %}
</div>
<div class="site-footer__payment">
{% for type in shop.enabled_payment_types %}
{{ type | payment_type_svg_tag }}
{% endfor %}
</div>
</div>
</div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Benefits Row"
    },
    {
      "type": "paragraph",
      "content": "Add, remove and reorder benefits using the “Benefit” blocks below. Each benefit has its own icon, title and text."
    },
    {
      "type": "header",
      "content": "Brand Column"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About text",
      "default": "Jolliet Group — we curate premium products for those who appreciate quality, craftsmanship, and timeless design."
    },
    {
      "type": "textarea",
      "id": "address_text",
      "label": "Address"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "info": "Include country code, e.g. +919876543210"
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email",
      "default": "support@jolliet.in"
    },
    {"type": "header", "content": "Quick Links column"},
    {"type": "text", "id": "quick_links_heading", "label": "Column heading", "default": "Quick Links"}
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shield",
          "options": [
            {"value": "shield", "label": "Shield (secure)"},
            {"value": "lock", "label": "Lock"},
            {"value": "returns", "label": "Returns / refresh"},
            {"value": "truck", "label": "Truck (delivery)"},
            {"value": "support", "label": "Chat / support"},
            {"value": "headset", "label": "Headset"},
            {"value": "phone", "label": "Phone"},
            {"value": "gift", "label": "Gift"},
            {"value": "tag", "label": "Price tag"},
            {"value": "star", "label": "Star"},
            {"value": "clock", "label": "Clock"},
            {"value": "leaf", "label": "Leaf (eco)"},
            {"value": "wallet", "label": "Wallet"},
            {"value": "check", "label": "Checklist"}
          ]
        },
        {"type": "text", "id": "title", "label": "Title", "default": "Benefit title"},
        {"type": "text", "id": "text", "label": "Subtext", "default": "Short description"}
      ]
    },
    {
      "type": "quick_link",
      "name": "Quick Link",
      "settings": [
        {"type": "text", "id": "link_label", "label": "Link text", "default": "Link"},
        {"type": "url", "id": "link_url", "label": "Link URL"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {"type": "benefit", "settings": {"icon": "shield", "title": "Secure Payment", "text": "100% secure transactions"}},
        {"type": "benefit", "settings": {"icon": "returns", "title": "Easy Returns", "text": "10-day hassle-free returns"}},
        {"type": "benefit", "settings": {"icon": "truck", "title": "Fast Delivery", "text": "Pan-India shipping"}},
        {"type": "benefit", "settings": {"icon": "support", "title": "Customer Support", "text": "Mon–Sat, 10 AM – 6 PM"}}
      ]
    }
  ]
}
{% endschema %}