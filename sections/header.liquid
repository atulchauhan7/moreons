<header class="site-header {% if section.settings.show_announcement %}has-announcement{% endif %}" data-header role="banner" aria-label="Site header">

<div class="site-header__inner">

  <!-- LEFT: Hamburger (mobile) + Logo -->
  <div class="site-header__brand">
    <button class="menu-toggle header-icon" aria-label="Menu" aria-expanded="false">
      <svg class="menu-toggle__open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="4" y1="7" x2="20" y2="7"/>
        <line x1="4" y1="12" x2="20" y2="12"/>
        <line x1="4" y1="17" x2="14" y2="17"/>
      </svg>
      <svg class="menu-toggle__close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:none">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <a href="{{ routes.root_url }}" class="site-header__logo">
      {% if section.settings.logo != blank %}
      <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" loading="eager" width="200" height="56" style="height:auto">
      {% else %}
      <span class="logo-text" data-logo-text>{{ shop.name }}</span>
      {% endif %}
    </a>
  </div>

  <!-- CENTER: Desktop Inline Navigation -->
  <nav class="site-header__mainnav" role="navigation" aria-label="Main navigation">
    {% assign _desk_links = linklists[section.settings.menu].links %}
    {% if _desk_links.size > 0 %}
      {% for link in _desk_links %}
      <div class="nav-item">
        <a href="{{ link.url }}"
           class="site-header__nav-link {% if link.active %}active{% endif %}"
           {% if link.url contains '/collections/' %}data-nav-collection-handle="{{ link.url | split: '/collections/' | last | split: '?' | first | split: '/' | first }}"{% endif %}
           {% if link.links.size > 0 %}
           data-nav-parent="true"
           aria-expanded="false"
           onclick="event.preventDefault();event.stopPropagation();var ni=this.closest('.nav-item'),mg=ni.querySelector('.mega-menu');if(!mg)return;var wasOpen=ni.classList.contains('is-open');document.querySelectorAll('.nav-item').forEach(function(o){o.classList.remove('is-open');var m=o.querySelector('.mega-menu');if(m)m.classList.remove('open');var a=o.querySelector('.site-header__nav-link[data-nav-parent]');if(a)a.setAttribute('aria-expanded','false');var ar=o.querySelector('.nav-arrow');if(ar)ar.style.transform=''});if(!wasOpen){ni.classList.add('is-open');mg.classList.add('open');this.setAttribute('aria-expanded','true');var aw=this.querySelector('.nav-arrow');if(aw)aw.style.transform='rotate(180deg)'}"
           {% endif %}>
          <span class="nav-link__text">{{ link.title }}</span>
          {% if link.links.size > 0 %}
          <svg class="nav-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          {% endif %}
        </a>
        {% if link.links.size > 0 %}
        <div class="mega-menu">
          <div class="mega-menu__grid">
            {% for child_link in link.links %}
            <div class="mega-menu__column">
              <a href="{{ child_link.url }}" class="mega-menu__column-title">{{ child_link.title }}</a>
              {% for grandchild in child_link.links %}
              <a href="{{ grandchild.url }}" class="mega-menu__link">{{ grandchild.title }}</a>
              {% endfor %}
            </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>
      {% endfor %}
    {% else %}
      {% comment %} Fallback hardcoded desktop nav {% endcomment %}
      {% assign _fallback_nav = 'Home,/|Summer Sale,/collections/best-seller|New Arrival,/collections/new-arrival|Best Seller,/collections/best-seller|Suit Sets,/collections/suit-sets|Kurta Sets,/collections/kurta-sets|Co-ord Sets,/collections/co-ord-sets|KARIGARI,/collections/embroidery|Our Story,/pages/our-story|Return and Exchange Policy,/pages/return-and-exchange-policy' | split: '|' %}
      {% for _item in _fallback_nav %}
        {% assign _parts = _item | split: ',' %}
        {% assign _title = _parts[0] %}
        {% assign _url   = _parts[1] %}
        <div class="nav-item">
          <a href="{{ _url }}" class="site-header__nav-link {% if request.path == _url %}active{% endif %}" {% if _url contains '/collections/' %}data-nav-collection-handle="{{ _url | split: '/collections/' | last | split: '?' | first | split: '/' | first }}"{% endif %}>
            <span class="nav-link__text">{{ _title }}</span>
          </a>
        </div>
      {% endfor %}
    {% endif %}
  </nav>

  <!-- RIGHT: Action Icons -->
  <div class="site-header__actions">
    <a href="{{ routes.search_url }}" class="header-icon" aria-label="Search" data-search-trigger>
      <i class="ri-search-line"></i>
    </a>
    <a href="{{ routes.account_url }}" class="header-icon header-icon--desktop-only" aria-label="Account">
      <i class="ri-user-line"></i>
    </a>
    <button class="header-icon" data-wishlist-trigger aria-label="Wishlist">
      <i class="ri-heart-line"></i>
      <span class="wishlist-count-badge" style="display:none;"></span>
    </button>
    <button class="header-icon" data-cart-trigger aria-label="Cart">
      <i class="ri-shopping-bag-line"></i>
      <span class="cart-count">{{ cart.item_count }}</span>
    </button>
  </div>

</div>

<!-- Inline Search Bar -->
<div class="header-search" data-header-search>
  <div class="header-search__inner">
    <form action="{{ routes.search_url }}" method="get" role="search" class="header-search__form" data-header-search-form>
      <input type="hidden" name="type" value="product">
      <svg class="header-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input type="search" name="q" class="header-search__input" placeholder="Search for tees, dresses, coords..." autocomplete="off" aria-label="Search products" aria-autocomplete="list" aria-controls="header-search-suggest" role="combobox" aria-expanded="false">
      <button type="button" class="header-search__clear" data-header-search-clear aria-label="Clear search" hidden>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
      </button>
      <button type="button" class="header-search__close" data-header-search-close aria-label="Close search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </form>

    <!-- Default state: recent + trending pills -->
    <div class="header-search__default" data-header-search-default>
      <div class="header-search__recent" data-header-search-recent hidden>
        <div class="header-search__group-head">
          <span class="header-search__group-label">Recent searches</span>
          <button type="button" class="header-search__clear-recent" data-header-search-clear-recent>Clear</button>
        </div>
        <div class="header-search__recent-list" data-header-search-recent-list></div>
      </div>
      <div class="header-search__trending">
        <div class="header-search__group-head">
          <span class="header-search__group-label">Trending</span>
        </div>
        <div class="header-search__tags">
          <a href="{{ routes.search_url }}?q=oversized+tee&type=product" class="header-search__tag">Oversized Tee</a>
          <a href="{{ routes.search_url }}?q=graphic+tee&type=product" class="header-search__tag">Graphic Tee</a>
          <a href="{{ routes.search_url }}?q=crop+top&type=product" class="header-search__tag">Crop Top</a>
          <a href="{{ routes.search_url }}?q=coord+set&type=product" class="header-search__tag">Coord Set</a>
          <a href="{{ routes.search_url }}?q=new+arrivals&type=product" class="header-search__tag">New Arrivals</a>
        </div>
      </div>
    </div>

    <!-- Predictive results -->
    <div class="header-search__suggest" id="header-search-suggest" data-header-search-suggest role="listbox" aria-label="Search suggestions" hidden></div>
  </div>
</div>

<!-- Mobile Slide-in Nav Drawer -->
<nav class="site-header__nav" role="navigation" aria-label="Mobile navigation">

  <!-- User greeting + close -->
  <div class="nav-mobile-header">
    <div class="nav-user-section">
      <div class="nav-user-avatar">
        <i class="ri-user-3-line" style="font-size:22px;"></i>
      </div>
      <div class="nav-user-info">
        <span class="nav-user-greeting">Hey There!</span>
        <a href="{{ routes.account_url }}" class="nav-user-login">Login / Sign Up</a>
      </div>
    </div>
    <button class="nav-mobile-close" aria-label="Close menu" data-nav-close>
      <i class="ri-close-line" style="font-size:22px;"></i>
    </button>
  </div>

  {% comment %} SHOP IN — Mobile category cards {% endcomment %}
  {% assign mobile_cats = section.blocks | where: 'type', 'mobile_category' %}
  {% if mobile_cats.size > 0 %}
  <p class="nav-section-label">SHOP IN</p>
  <div class="nav-mobile-categories">
    {% for block in mobile_cats %}
    <a href="{{ block.settings.link | default: '#' }}" class="nav-mobile-cat" {{ block.shopify_attributes }}>
      <div class="nav-mobile-cat__img-wrap">
        {% if block.settings.image != blank %}
        <img
          src="{{ block.settings.image | image_url: width: 200 }}"
          srcset="{{ block.settings.image | image_url: width: 100 }} 100w, {{ block.settings.image | image_url: width: 200 }} 200w"
          sizes="80px"
          alt="{{ block.settings.label | escape }}"
          loading="lazy"
          decoding="async"
          width="200"
          height="200"
        >
        {% else %}
        {{ 'collection-1' | placeholder_svg_tag: 'nav-mobile-cat__placeholder' }}
        {% endif %}
      </div>
      <span class="nav-mobile-cat__label">{{ block.settings.label }}</span>
    </a>
    {% endfor %}
  </div>
  {% endif %}

  <div class="nav-mobile-links">
    {% assign _nav_links = linklists[section.settings.menu].links %}
    {% if _nav_links.size > 0 %}
      {% for link in _nav_links %}
      <div class="nav-item">
        <a href="{{ link.url }}" class="site-header__nav-link {% if link.active %}active{% endif %}" {% if link.url contains '/collections/' %}data-nav-collection-handle="{{ link.url | split: '/collections/' | last | split: '?' | first | split: '/' | first }}"{% endif %} {% if link.links.size > 0 %}data-nav-parent="true" aria-expanded="false" onclick="event.preventDefault();event.stopPropagation();var ni=this.closest('.nav-item'),mg=ni.querySelector('.mega-menu');if(!mg)return;var wasOpen=ni.classList.contains('is-open');document.querySelectorAll('.nav-item').forEach(function(o){o.classList.remove('is-open');var m=o.querySelector('.mega-menu');if(m)m.classList.remove('open');var a=o.querySelector('.site-header__nav-link[data-nav-parent]');if(a)a.setAttribute('aria-expanded','false');var ar=o.querySelector('.nav-arrow');if(ar)ar.style.transform=''});if(!wasOpen){ni.classList.add('is-open');mg.classList.add('open');this.setAttribute('aria-expanded','true');var aw=this.querySelector('.nav-arrow');if(aw)aw.style.transform='rotate(180deg)'}"{% endif %}>
          <span class="nav-link__inner">
            <span class="nav-link__thumb" style="display:none"></span>
            <span class="nav-link__text">{{ link.title }}</span>
          </span>
          {% if link.links.size > 0 %}
          <svg class="nav-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          {% endif %}
        </a>
        {% if link.links.size > 0 %}
        <div class="mega-menu">
          <div class="mega-menu__grid">
            {% for child_link in link.links %}
            <div class="mega-menu__column">
              <a href="{{ child_link.url }}" class="mega-menu__column-title">{{ child_link.title }}</a>
              {% for grandchild in child_link.links %}
              <a href="{{ grandchild.url }}" class="mega-menu__link">{{ grandchild.title }}</a>
              {% endfor %}
            </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>
      {% endfor %}
    {% else %}
      {% comment %} Fallback hardcoded links — used when Shopify nav 'main-menu-1' is not configured {% endcomment %}
      {% assign _fallback_nav = 'Home,/|Summer Sale,/collections/best-seller|New Arrival,/collections/new-arrival|Best Seller,/collections/best-seller|Suit Sets,/collections/suit-sets|Kurta Sets,/collections/kurta-sets|Co-ord Sets,/collections/co-ord-sets|KARIGARI,/collections/embroidery|Our Story,/pages/our-story|Return and Exchange Policy,/pages/return-and-exchange-policy' | split: '|' %}
      {% for _item in _fallback_nav %}
        {% assign _parts = _item | split: ',' %}
        {% assign _title = _parts[0] %}
        {% assign _url   = _parts[1] %}
        <div class="nav-item">
          <a href="{{ _url }}" class="site-header__nav-link {% if request.path == _url %}active{% endif %}" {% if _url contains '/collections/' %}data-nav-collection-handle="{{ _url | split: '/collections/' | last | split: '?' | first | split: '/' | first }}"{% endif %}>
            <span class="nav-link__inner">
              <span class="nav-link__thumb" style="display:none"></span>
              <span class="nav-link__text">{{ _title }}</span>
            </span>
          </a>
        </div>
      {% endfor %}
    {% endif %}
  </div>
  <div class="nav-collections" id="nav-collections"></div>

  <!-- ENGAGE -->
  {% if section.settings.show_engage_section %}
  <p class="nav-section-label">ENGAGE</p>
  <div class="nav-engage-links">
    {% if section.settings.find_store_url != blank %}
    <a href="{{ section.settings.find_store_url }}" class="nav-engage-link">
      <span class="nav-engage-link__icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1-5h16l1 5"/><path d="M5 9v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9"/><path d="M9 22V12h6v10"/></svg>
      </span>
      <span class="nav-engage-link__text">Find a Store</span>
      <svg class="nav-engage-link__chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </a>
    {% endif %}
    {% if section.settings.track_order_url != blank %}
    <a href="{{ section.settings.track_order_url }}" class="nav-engage-link">
      <span class="nav-engage-link__icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      </span>
      <span class="nav-engage-link__text">Track Order</span>
      <svg class="nav-engage-link__chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </a>
    {% endif %}
  </div>
  {% endif %}

  <!-- MY PROFILE quick tiles -->
  <p class="nav-section-label">MY PROFILE</p>
  <div class="nav-profile-tiles">
    <a href="{{ routes.account_url }}" class="nav-profile-tile">
      <i class="ri-user-line nav-profile-tile__icon"></i>
      My Account
    </a>
    <a href="{{ routes.account_url }}/orders" class="nav-profile-tile">
      <i class="ri-inbox-line nav-profile-tile__icon"></i>
      My Orders
    </a>
    <a href="{{ routes.account_url }}" class="nav-profile-tile">
      <i class="ri-bank-card-line nav-profile-tile__icon"></i>
      My Wallet
    </a>
    <button type="button" class="nav-profile-tile" data-wishlist-trigger>
      <i class="ri-heart-line nav-profile-tile__icon"></i>
      My Wishlist
    </button>
  </div>


</nav>
<div class="nav-overlay" data-nav-overlay></div>

<script>
(function(){
  var container=document.getElementById('nav-collections');
  var handles=[];
  {% for link in linklists[section.settings.menu].links %}
    {% if link.url contains '/collections/' %}
      handles.push({url:{{ link.url | json }},title:{{ link.title | json }},handle:{{ link.url | split: '/collections/' | last | split: '?' | first | split: '/' | first | json }}});
    {% endif %}
  {% endfor %}
  if(!handles.length)return;

  var CACHE_KEY='sakhi_nav_collections_v1';
  var CACHE_TTL=6*60*60*1000;
  var started=false;
  var menuToggleBtn=document.querySelector('.menu-toggle');
  var idleCb=window.requestIdleCallback||function(fn){return setTimeout(fn,2500)};

  function renderFromList(items){
    if(!items||!items.length)return;
    var html='<div class="nav-collections__scroll">';
    items.forEach(function(it){
      if(!it.img)return;
      html+='<a href="'+it.url+'" class="nav-collections__item">'
        +'<div class="nav-collections__img-wrap">'
        +'<img src="'+it.img+'" alt="'+it.title+'" loading="lazy" width="140" height="180">'
        +'</div>'
        +'<span class="nav-collections__label">'+it.title+'</span></a>';
      var navLink=document.querySelector('[data-nav-collection-handle="'+it.handle+'"]');
      if(navLink){
        var thumb=navLink.querySelector('.nav-link__thumb');
        if(thumb){thumb.innerHTML='<img src="'+it.img+'" alt="" width="40" height="40">';thumb.style.display='';}
      }
    });
    html+='</div>';
    if(container)container.innerHTML=html;
  }

  function loadFromCache(){
    try{
      var raw=sessionStorage.getItem(CACHE_KEY);
      if(!raw)return false;
      var parsed=JSON.parse(raw);
      if(!parsed||!parsed.t||Date.now()-parsed.t>CACHE_TTL)return false;
      renderFromList(parsed.items||[]);
      return true;
    }catch(e){return false}
  }

  function fetchAll(){
    if(started)return;started=true;
    if(loadFromCache())return;
    var results=new Array(handles.length);
    var done=0;
    handles.forEach(function(item,i){
      if(!item.handle){results[i]=null;done++;if(done>=handles.length)finalize();return;}
      fetch('/collections/'+encodeURIComponent(item.handle)+'.json')
        .then(function(r){if(!r.ok)throw new Error(r.status);return r.json()})
        .then(function(data){
          var col=data.collection;
          var img=col.image?col.image.src:null;
          if(!img&&col.products&&col.products.length){
            for(var k=0;k<col.products.length;k++){
              if(col.products[k].images&&col.products[k].images.length){img=col.products[k].images[0].src;break;}
            }
          }
          results[i]={handle:item.handle,url:item.url,title:col.title||item.title,img:img};
        })
        .catch(function(){results[i]=null})
        .finally(function(){done++;if(done>=handles.length)finalize()});
    });
    function finalize(){
      var clean=results.filter(function(x){return x&&x.img});
      try{sessionStorage.setItem(CACHE_KEY,JSON.stringify({t:Date.now(),items:clean}))}catch(e){}
      renderFromList(clean);
    }
  }

  /* Render instantly from cache if available so nav drawer is never empty. */
  loadFromCache();
  /* Fetch only on demand: mobile-nav open, or well after first paint on desktop. */
  if(menuToggleBtn)menuToggleBtn.addEventListener('click',function(){idleCb(fetchAll)});
  idleCb(function(){setTimeout(fetchAll,4000)});
})();
</script>

</header>

