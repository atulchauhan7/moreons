{% if section.settings.show_section %}
<section class="usp-strip" data-section-id="{{ section.id }}" aria-label="Store benefits">
  <div class="usp-strip__track" data-usp-track>
    {% comment %} Render items twice so the marquee loop is seamless {% endcomment %}
    {% for round in (1..2) %}
    <ul class="usp-strip__list" {% if round == 2 %}aria-hidden="true"{% endif %}>
      {% for block in section.blocks %}
      <li class="usp-strip__item" {% if round == 1 %}{{ block.shopify_attributes }}{% endif %}>
        <span class="usp-strip__icon">
          {% case block.settings.icon %}
          {% when 'shipping' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          {% when 'returns' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          {% when 'secure' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          {% when 'cod' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M6 12h.01M18 12h.01"/></svg>
          {% when 'support' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          {% when 'quality' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {% when 'authentic' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 22s8-4 8-12V5l-8-3-8 3v5c0 8 8 12 8 12z"/><polyline points="9 12 11 14 15 10"/></svg>
          {% when 'india' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          {% else %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="9 12 11 14 15 10"/></svg>
          {% endcase %}
        </span>
        <span class="usp-strip__text">
          <strong>{{ block.settings.title }}</strong>
          {% if block.settings.subtext != blank %}<span>{{ block.settings.subtext }}</span>{% endif %}
        </span>
      </li>
      {% endfor %}
    </ul>
    {% endfor %}
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "USP Strip",
  "tag": "section",
  "class": "section-usp-strip",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show section", "default": true },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "background", "label": "Background", "default": "light", "options": [
      { "value": "light", "label": "Light" },
      { "value": "dark", "label": "Dark" },
      { "value": "cream", "label": "Cream" }
    ]},
    { "type": "range", "id": "speed", "label": "Scroll speed (sec)", "min": 20, "max": 80, "step": 5, "default": 40 }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shipping", "options": [
          { "value": "shipping", "label": "Shipping" },
          { "value": "returns", "label": "Returns" },
          { "value": "secure", "label": "Secure" },
          { "value": "cod", "label": "Cash on Delivery" },
          { "value": "support", "label": "Support" },
          { "value": "quality", "label": "Quality" },
          { "value": "authentic", "label": "Authentic" },
          { "value": "india", "label": "Made in India" }
        ]},
        { "type": "text", "id": "title", "label": "Title", "default": "Free Shipping" },
        { "type": "text", "id": "subtext", "label": "Subtext (optional)", "default": "On orders above ₹999" }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP Strip",
      "blocks": [
        { "type": "usp", "settings": { "icon": "shipping", "title": "Free Shipping", "subtext": "On orders above ₹999" }},
        { "type": "usp", "settings": { "icon": "returns", "title": "Easy Returns", "subtext": "7-day return policy" }},
        { "type": "usp", "settings": { "icon": "secure", "title": "Secure Payments", "subtext": "100% protected checkout" }},
        { "type": "usp", "settings": { "icon": "cod", "title": "Cash on Delivery", "subtext": "Available across India" }},
        { "type": "usp", "settings": { "icon": "authentic", "title": "100% Authentic", "subtext": "Quality you can trust" }},
        { "type": "usp", "settings": { "icon": "support", "title": "24x7 Support", "subtext": "We're always here for you" }}
      ]
    }
  ]
}
{% endschema %}
